# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Large UCI extract — commit the zip, not the unpacked CSV
data/raw/online_retail_II.csv

# Local .terraform directories (downloaded providers, modules — large, regenerable)
**/.terraform/*

# .tfstate files — contain SENSITIVE state including resource IDs, IPs, and
# sometimes secrets. NEVER commit these. In a team setting, use remote state
# (S3 + DynamoDB lock).
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files containing real values. The .example file IS safe to commit;
# the real .tfvars file contains your IP, your project name, etc., and
# COULD contain sensitive values in larger projects.
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Override files (used for local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan output files
*.tfplan
